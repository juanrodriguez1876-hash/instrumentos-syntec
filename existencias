<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Existencias | Instrumentos Sintek</title>
  <link rel="stylesheet" href="estilos.css">
  <script src="layout.js"></script>
</head>
<body>
  <header class="barra">
    <a href="menu.html" class="boton-barra" aria-label="Ir al menú principal">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </a>
    <svg class="logo" viewBox="0 0 64 72" role="img" aria-label="Logo Instrumentos Sintek">
      <path d="M32 2C14 2 4 14 4 30c0 16 16 30 28 40 12-10 28-24 28-40C60 14 50 2 32 2Z" fill="#0b1f4b"/>
      <text x="32" y="40" text-anchor="middle" font-size="22" font-weight="600" fill="#fff" font-family="Oswald, Arial, sans-serif">IS</text>
    </svg>
  </header>
  <main class="contenido">
    <h1 class="titulo">Existencias</h1>
    <p class="nota">La marca vertical de cada barra indica el stock mínimo.</p>
    <div class="tabla-contenedor">
      <table class="tabla tabla--tarjetas" aria-label="Existencias de productos">
        <thead><tr><th scope="col">Producto</th><th scope="col" class="numero">Stock</th><th scope="col" class="numero">Mínimo</th><th scope="col">Nivel</th><th scope="col">Estado</th></tr></thead>
        <tbody>
                    <tr><td data-label="Producto">Guitarra eléctrica</td><td class="numero" data-label="Stock">15</td><td class="numero" data-label="Mínimo">5</td><td class="ancho" data-label="Nivel"><div class="medidor medidor--ok" role="img" aria-label="Stock 15, mínimo 5"><i style="width:100%"></i></div></td><td data-label="Estado"><span class="estado estado--ok">Disponible</span></td></tr>
                    <tr><td data-label="Producto">Guitarra acústica</td><td class="numero" data-label="Stock">20</td><td class="numero" data-label="Mínimo">8</td><td class="ancho" data-label="Nivel"><div class="medidor medidor--ok" role="img" aria-label="Stock 20, mínimo 8"><i style="width:83%"></i></div></td><td data-label="Estado"><span class="estado estado--ok">Disponible</span></td></tr>
                    <tr><td data-label="Producto">Saxofón alto</td><td class="numero" data-label="Stock">4</td><td class="numero" data-label="Mínimo">5</td><td class="ancho" data-label="Nivel"><div class="medidor medidor--poco" role="img" aria-label="Stock 4, mínimo 5"><i style="width:27%"></i></div></td><td data-label="Estado"><span class="estado estado--poco">Por agotarse</span></td></tr>
                    <tr><td data-label="Producto">Ukelele</td><td class="numero" data-label="Stock">0</td><td class="numero" data-label="Mínimo">3</td><td class="ancho" data-label="Nivel"><div class="medidor medidor--no" role="img" aria-label="Stock 0, mínimo 3"><i style="width:0%"></i></div></td><td data-label="Estado"><span class="estado estado--no">No disponible</span></td></tr>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
