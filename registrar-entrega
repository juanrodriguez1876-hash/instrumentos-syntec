<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registrar entrega | Instrumentos Sintek</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=Nunito+Sans:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="estilos.css">
  <script src="layout.js"></script>
</head>
<body>

  <main class="contenido">
    <h1 class="titulo">Registrar entrega</h1>

    <!-- Al marcar la entrega como Recibida, las existencias del producto aumentan. Solo se ofrecen proveedores activos. -->
    <form class="formulario formulario--doble" action="proveedores.html" method="get">
      <p class="nota-campos"><span class="requerido" aria-hidden="true">*</span> Campos obligatorios</p>
      <div class="campo"><label for="proveedor">Proveedor <span class="requerido" aria-hidden="true">*</span></label><select id="proveedor" name="proveedor" required><option value="" disabled selected>Selecciona un proveedor</option><option value="1">Gibson</option><option value="2">Fender</option></select></div>
      <div class="campo"><label for="producto">Producto <span class="requerido" aria-hidden="true">*</span></label><select id="producto" name="producto" required><option value="" disabled selected>Selecciona un producto</option><option value="1">Guitarra eléctrica</option><option value="2">Púas Fender (paquete de 12)</option></select></div>
      <div class="campo"><label for="cantidad">Cantidad <span class="requerido" aria-hidden="true">*</span></label><input type="number" id="cantidad" name="cantidad" required min="1"></div>
      <div class="campo"><label for="estado">Estado <span class="requerido" aria-hidden="true">*</span></label><select id="estado" name="estado" required><option value="programada">Programada</option><option value="recibida">Recibida</option></select><small>Al marcarla como Recibida, suma las piezas al stock.</small></div>
      <div class="campo"><label for="fecha">Fecha de llegada <span class="requerido" aria-hidden="true">*</span></label><input type="date" id="fecha" name="fecha" required></div>
      <div class="campo"><label for="hora">Hora de llegada <span class="requerido" aria-hidden="true">*</span></label><input type="time" id="hora" name="hora" required></div>
      <div class="acciones">
        <a href="proveedores.html" class="boton boton--contorno">Cancelar</a>
        <button type="submit" class="boton">Guardar entrega</button>
      </div>
    </form>
  </main>

</body>
</html>
