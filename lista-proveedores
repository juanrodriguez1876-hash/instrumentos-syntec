<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lista de proveedores | Instrumentos Sintek</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=Nunito+Sans:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="estilos.css">
  <script src="layout.js"></script>
</head>
<body>

  <header class="barra">
    <!-- Botón de inicio: regresa al menú -->
    <a href="menu.html" class="boton-barra" aria-label="Ir al menú principal">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/>
      </svg>
    </a>

    <svg class="logo" viewBox="0 0 64 72" role="img" aria-label="Logo Instrumentos Sintek">
      <path d="M32 2C14 2 4 14 4 30c0 16 16 30 28 40 12-10 28-24 28-40C60 14 50 2 32 2Z" fill="#0b1f4b"/>
      <text x="32" y="40" text-anchor="middle" font-size="22" font-weight="600" fill="#fff" font-family="Oswald, Arial, sans-serif">IS</text>
    </svg>
  </header>

  <main class="contenido">
    <div class="barra-accion">
      <a href="registrar-proveedor.html" class="enlace-accion">
        Registrar proveedor
        <span class="icono-mas" aria-hidden="true">+</span>
      </a>
    </div>

    <h1 class="titulo">Lista de proveedores</h1>

    <!-- Datos de ejemplo e inventados; después vendrán de la base de datos.
         "Dar de baja" NO borra: el proveedor pasa a Inactivo y sus entregas anteriores se conservan.
         En celular la tabla se ve como tarjetas (clase tabla--tarjetas); por eso cada celda
         lleva data-label con el nombre de su columna. -->
    <div class="tabla-contenedor">
      <table class="tabla tabla--tarjetas" aria-label="Proveedores registrados">
        <thead>
          <tr>
            <th scope="col">Proveedor</th>
            <th scope="col">Contacto</th>
            <th scope="col">Teléfono</th>
            <th scope="col">Estado</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="Proveedor">Gibson</td>
            <td data-label="Contacto">Laura Méndez</td>
            <td data-label="Teléfono">33 1234 5678</td>
            <td data-label="Estado"><span class="estado estado--ok">Activo</span></td>
            <td data-label="Acciones">
              <form class="acciones-fila" action="#" method="post">
                <a href="registrar-proveedor.html?id=1" class="boton boton--chico boton--contorno" aria-label="Editar proveedor Gibson">Editar</a>
                <button type="submit" class="boton boton--chico boton--peligro" aria-label="Dar de baja a Gibson"
                        onclick="return confirm('¿Dar de baja a Gibson? Sus entregas anteriores se conservan.')">Dar de baja</button>
              </form>
            </td>
          </tr>
          <tr>
            <td data-label="Proveedor">Fender</td>
            <td data-label="Contacto">Carlos Ibarra</td>
            <td data-label="Teléfono">33 9876 5432</td>
            <td data-label="Estado"><span class="estado estado--ok">Activo</span></td>
            <td data-label="Acciones">
              <form class="acciones-fila" action="#" method="post">
                <a href="registrar-proveedor.html?id=2" class="boton boton--chico boton--contorno" aria-label="Editar proveedor Fender">Editar</a>
                <button type="submit" class="boton boton--chico boton--peligro" aria-label="Dar de baja a Fender"
                        onclick="return confirm('¿Dar de baja a Fender? Sus entregas anteriores se conservan.')">Dar de baja</button>
              </form>
            </td>
          </tr>
          <tr>
            <td data-label="Proveedor">Yamaha</td>
            <td data-label="Contacto">Sofía Ramírez</td>
            <td data-label="Teléfono">33 1112 2233</td>
            <td data-label="Estado"><span class="estado estado--neutro">Inactivo</span></td>
            <td data-label="Acciones">
              <form class="acciones-fila" action="#" method="post">
                <a href="registrar-proveedor.html?id=3" class="boton boton--chico boton--contorno" aria-label="Editar proveedor Yamaha">Editar</a>
                <button type="submit" class="boton boton--chico" aria-label="Reactivar a Yamaha">Reactivar</button>
              </form>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>

</body>
</html>
