<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registrar proveedor | Instrumentos Sintek</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=Nunito+Sans:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="estilos.css">
  <script src="layout.js"></script>
</head>
<body>

  <header class="barra">
    <!-- Botón de inicio: regresa al menú -->
    <a href="menu.html" class="boton-barra" aria-label="Ir al menú principal">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/>
      </svg>
    </a>

    <svg class="logo" viewBox="0 0 64 72" role="img" aria-label="Logo Instrumentos Sintek">
      <path d="M32 2C14 2 4 14 4 30c0 16 16 30 28 40 12-10 28-24 28-40C60 14 50 2 32 2Z" fill="#0b1f4b"/>
      <text x="32" y="40" text-anchor="middle" font-size="22" font-weight="600" fill="#fff" font-family="Oswald, Arial, sans-serif">IS</text>
    </svg>
  </header>

  <main class="contenido">
    <h1 class="titulo">Registrar proveedor</h1>

    <!-- Por ahora "Guardar" solo regresa a la lista.
         Más adelante el atributo action apuntará al backend que guarda al proveedor.
         Esta misma pantalla sirve para EDITAR: el backend la llena con los datos del proveedor (?id=...). -->
    <form class="formulario" action="lista-proveedores.html" method="get">
      <p class="nota-campos"><span class="requerido" aria-hidden="true">*</span> Campos obligatorios</p>

      <div class="campo">
        <label for="nombre">Nombre del proveedor <span class="requerido" aria-hidden="true">*</span></label>
        <input type="text" id="nombre" name="nombre" maxlength="255" autocomplete="organization" required>
      </div>

      <div class="campo">
        <label for="contacto">Persona de contacto</label>
        <input type="text" id="contacto" name="contacto" maxlength="255" autocomplete="name" placeholder="Nombre y apellidos">
      </div>

      <div class="campo">
        <label for="telefono">Teléfono <span class="requerido" aria-hidden="true">*</span></label>
        <input type="tel" id="telefono" name="telefono" inputmode="tel" pattern="[0-9]{10,15}" maxlength="15" title="Solo números, de 10 a 15 dígitos" placeholder="10 dígitos" required>
      </div>

      <div class="campo">
        <label for="correo">Correo electrónico</label>
        <input type="email" id="correo" name="correo" maxlength="255" autocomplete="email">
      </div>

      <div class="acciones acciones--centro">
        <a href="lista-proveedores.html" class="boton boton--contorno">Cancelar</a>
        <button type="submit" class="boton">Guardar</button>
      </div>
    </form>
  </main>

</body>
</html>
