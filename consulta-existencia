<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Consulta de existencia | Instrumentos Sintek</title>
  <link rel="stylesheet" href="estilos.css">
  <script src="layout.js"></script>
</head>
<body>
  <header class="barra">
    <a href="menu.html" class="boton-barra" aria-label="Ir al menú principal">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </a>
    <svg class="logo" viewBox="0 0 64 72" role="img" aria-label="Logo Instrumentos Sintek">
      <path d="M32 2C14 2 4 14 4 30c0 16 16 30 28 40 12-10 28-24 28-40C60 14 50 2 32 2Z" fill="#0b1f4b"/>
      <text x="32" y="40" text-anchor="middle" font-size="22" font-weight="600" fill="#fff" font-family="Oswald, Arial, sans-serif">IS</text>
    </svg>
  </header>
  <main class="contenido">
    <h1 class="titulo">Consulta de existencia</h1>
    <form class="busqueda" role="search" action="#" method="get">
      <div class="busqueda__barra">
        <label for="buscar" class="solo-lectores">Buscar por nombre o ID</label>
        <input type="search" id="buscar" name="buscar" placeholder="Buscar por nombre o id">
        <button type="submit" class="boton">Buscar</button>
      </div>
      <div class="filtros">
        <select name="tipo" aria-label="Filtrar por tipo"><option value="" selected>Tipo</option></select>
        <select name="marca" aria-label="Filtrar por marca"><option value="" selected>Marca</option></select>
        <select name="accesorios" aria-label="Filtrar por accesorios"><option value="" selected>Accesorios</option></select>
        <select name="material" aria-label="Filtrar por material"><option value="" selected>Material</option></select>
      </div>
    </form>
    <section class="resultado" aria-label="Resultado de la consulta">
      <dl class="ficha">
        <div class="dato"><dt>Nombre</dt><dd>Guitarra eléctrica</dd></div>
        <div class="dato"><dt>Código</dt><dd>23145</dd></div>
        <div class="dato"><dt>Precio</dt><dd>$8,700.00</dd></div>
        <div class="dato"><dt>Stock disponible</dt><dd>15</dd></div>
      </dl>
      <p class="estado estado--ok estado--grande">Disponible</p>
    </section>
  </main>
</body>
</html>
