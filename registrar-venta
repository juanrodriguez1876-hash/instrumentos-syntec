<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registrar venta | Instrumentos Sintek</title>
  <link rel="stylesheet" href="estilos.css">
  <script src="layout.js"></script>
</head>
<body>
  <header class="barra">
    <a href="menu.html" class="boton-barra" aria-label="Ir al menú principal">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </a>
    <svg class="logo" viewBox="0 0 64 72" role="img" aria-label="Logo Instrumentos Sintek">
      <path d="M32 2C14 2 4 14 4 30c0 16 16 30 28 40 12-10 28-24 28-40C60 14 50 2 32 2Z" fill="#0b1f4b"/>
      <text x="32" y="40" text-anchor="middle" font-size="22" font-weight="600" fill="#fff" font-family="Oswald, Arial, sans-serif">IS</text>
    </svg>
  </header>
  <main class="contenido">
    <h1 class="titulo">Registrar venta</h1>
    <form class="formulario" action="metodo-pago.html" method="get">
      <div class="campo"><label for="folio">Folio de venta</label><input type="number" id="folio" name="folio" min="1" required></div>
      <div class="campo"><label for="fecha">Fecha</label><input type="date" id="fecha" name="fecha" required></div>
      <div class="campo"><label for="cliente">Cliente</label>
        <select id="cliente" name="cliente" required><option value="" disabled selected>Selecciona un cliente</option></select>
        <small><a href="registrar-cliente.html" class="enlace-simple">Registrar cliente nuevo</a></small></div>
      <div class="campo"><label for="producto">Productos</label>
        <div class="fila">
          <select id="producto" name="producto"><option value="" disabled selected>Selecciona un producto</option></select>
          <input type="number" id="cantidad" name="cantidad" min="1" value="1" aria-label="Cantidad">
          <button type="button" class="boton">Agregar</button>
        </div></div>
      <dl class="totales">
        <div><dt>Subtotal</dt><dd>$0.00</dd></div>
        <div><dt>IVA</dt><dd>$0.00</dd></div>
        <div class="total"><dt>TOTAL</dt><dd>$0.00</dd></div>
      </dl>
      <div class="acciones">
        <a href="menu.html" class="boton boton--contorno">Cancelar</a>
        <button type="submit" class="boton">Continuar al pago</button>
      </div>
    </form>
  </main>
</body>
</html>
